generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum StatusGira {
  AGUARDANDO
  EM_ANDAMENTO
  CONCLUIDA
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  nome              String?
  password          String
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  pushSubscriptions PushSubscription[]
  presencas         PresencaGira[]
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Publicacao {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  capaUrl   String?
  publicado Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Documento {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  fileUrl   String
  fileType  String
  tamanho   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificacaoConfig {
  id           Int      @id @default(1)
  novaEntidade Boolean  @default(true)
  novaErva     Boolean  @default(true)
  novaBebida   Boolean  @default(true)
  novaMusica   Boolean  @default(true)
  novaGira       Boolean  @default(true)
  novaPublicacao Boolean  @default(true)
  novoDocumento  Boolean  @default(true)
  gira1Semana  Boolean  @default(true)
  gira1Dia     Boolean  @default(true)
  giraNoDia    Boolean  @default(true)
  playlistUrl  String?
  updatedAt    DateTime @updatedAt
}

model Agregador {
  id        Int      @id @default(autoincrement())
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  musicas   Musica[]
}

model Musica {
  id          Int              @id @default(autoincrement())
  titulo      String
  letra       String
  agregadorId Int?
  agregador   Agregador?       @relation(fields: [agregadorId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  entidades   EntidadeMusica[]
  giras       GiraMusica[]
}

model Erva {
  id         Int           @id @default(autoincrement())
  nome       String
  descricao  String
  usos       String
  fotoUrl    String?
  noQuintal  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  entidades  EntidadeErva[]
}

model Bebida {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String
  observacoes  String?
  fotoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Entidade {
  id         Int              @id @default(autoincrement())
  nome       String
  historia   String
  saudacao   String
  coresVelas String
  diaSemana  String?
  oferendas  String?
  fotoUrl    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  musicas    EntidadeMusica[]
  ervas      EntidadeErva[]
  giras      GiraEntidade[]
}

model Rotina {
  id        Int          @id @default(autoincrement())
  titulo    String
  descricao String
  ordem     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  giras     GiraRotina[]
}

model Gira {
  id         Int            @id @default(autoincrement())
  data       DateTime
  titulo     String
  descricao  String?
  instrucoes String?
  status     StatusGira     @default(AGUARDANDO)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  entidades  GiraEntidade[]
  musicas    GiraMusica[]
  rotinas    GiraRotina[]
  presencas  PresencaGira[]
}

model PresencaGira {
  id             Int      @id @default(autoincrement())
  giraId         Int
  userId         Int
  confirmado     Boolean
  justificativa  String?
  dataRespondida DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  gira           Gira     @relation(fields: [giraId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giraId, userId])
}

model EntidadeMusica {
  entidadeId Int
  musicaId   Int
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  musica     Musica   @relation(fields: [musicaId], references: [id], onDelete: Cascade)

  @@id([entidadeId, musicaId])
}

model EntidadeErva {
  entidadeId Int
  ervaId     Int
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  erva       Erva     @relation(fields: [ervaId], references: [id], onDelete: Cascade)

  @@id([entidadeId, ervaId])
}

model GiraEntidade {
  giraId     Int
  entidadeId Int
  gira       Gira     @relation(fields: [giraId], references: [id], onDelete: Cascade)
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)

  @@id([giraId, entidadeId])
}

model GiraMusica {
  giraId   Int
  musicaId Int
  gira     Gira   @relation(fields: [giraId], references: [id], onDelete: Cascade)
  musica   Musica @relation(fields: [musicaId], references: [id], onDelete: Cascade)

  @@id([giraId, musicaId])
}

model GiraRotina {
  giraId   Int
  rotinaId Int
  gira     Gira   @relation(fields: [giraId], references: [id], onDelete: Cascade)
  rotina   Rotina @relation(fields: [rotinaId], references: [id], onDelete: Cascade)

  @@id([giraId, rotinaId])
}

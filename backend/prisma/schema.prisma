generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nome      String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Agregador {
  id        Int      @id @default(autoincrement())
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  musicas   Musica[]
}

model Musica {
  id          Int              @id @default(autoincrement())
  titulo      String
  letra       String
  youtubeUrl  String?
  agregadorId Int?
  agregador   Agregador?       @relation(fields: [agregadorId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  entidades   EntidadeMusica[]
  giras       GiraMusica[]
}

model Erva {
  id         Int           @id @default(autoincrement())
  nome       String
  descricao  String
  usos       String
  fotoUrl    String?
  noQuintal  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  entidades  EntidadeErva[]
}

model Entidade {
  id         Int              @id @default(autoincrement())
  nome       String
  historia   String
  saudacao   String
  coresVelas String
  fotoUrl    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  musicas    EntidadeMusica[]
  ervas      EntidadeErva[]
  giras      GiraEntidade[]
}

model Rotina {
  id        Int          @id @default(autoincrement())
  titulo    String
  descricao String
  ordem     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  giras     GiraRotina[]
}

model Gira {
  id         Int            @id @default(autoincrement())
  data       DateTime
  titulo     String
  descricao  String?
  instrucoes String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  entidades  GiraEntidade[]
  musicas    GiraMusica[]
  rotinas    GiraRotina[]
}

model EntidadeMusica {
  entidadeId Int
  musicaId   Int
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  musica     Musica   @relation(fields: [musicaId], references: [id], onDelete: Cascade)

  @@id([entidadeId, musicaId])
}

model EntidadeErva {
  entidadeId Int
  ervaId     Int
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  erva       Erva     @relation(fields: [ervaId], references: [id], onDelete: Cascade)

  @@id([entidadeId, ervaId])
}

model GiraEntidade {
  giraId     Int
  entidadeId Int
  gira       Gira     @relation(fields: [giraId], references: [id], onDelete: Cascade)
  entidade   Entidade @relation(fields: [entidadeId], references: [id], onDelete: Cascade)

  @@id([giraId, entidadeId])
}

model GiraMusica {
  giraId   Int
  musicaId Int
  gira     Gira   @relation(fields: [giraId], references: [id], onDelete: Cascade)
  musica   Musica @relation(fields: [musicaId], references: [id], onDelete: Cascade)

  @@id([giraId, musicaId])
}

model GiraRotina {
  giraId   Int
  rotinaId Int
  gira     Gira   @relation(fields: [giraId], references: [id], onDelete: Cascade)
  rotina   Rotina @relation(fields: [rotinaId], references: [id], onDelete: Cascade)

  @@id([giraId, rotinaId])
}
